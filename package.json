{
  "name": "obsidian-proton-drive-sync",
  "version": "0.2.0",
  "description": "Sync your Obsidian vault to Proton Drive using the official Proton Drive CLI.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "proton-drive",
    "sync"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0"
  }
}
